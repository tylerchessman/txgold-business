{
  "name": "@txgold/business",
  "version": "0.3.0",
  "description": "TxGold Business API client for Node.js: signed requests, payments, payment requests, holds, accounts.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18.17" },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/cjs-package.mjs",
    "test": "tsc -p tsconfig.test.json && cd build-test && node --test",
    "prepack": "npm run build"
  },
  "repository": { "type": "git", "url": "git+https://github.com/tylerchessman/txgold-business.git", "directory": "sdk/javascript" },
  "homepage": "https://docs.txgold.money",
  "keywords": ["txgold", "payments", "gold", "api"],
  "devDependencies": {
    "@types/node": "18.19.130",
    "typescript": "5.6.3"
  }
}
