                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "503": {
            "description": "sandbox_unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sandbox/payment-requests/{id}/pay": {
      "post": {
        "tags": [
          "Sandbox"
        ],
        "summary": "Have a demo customer pay a payment request (Sandbox only)",
        "description": "Pays one of your pending payment requests from the demo customer it was sent to, exactly as the customer would in the TxGold app, so you can test your flow without a phone. An open request is paid by the demo customer in payerAccountId, or your first one. The customer is funded first if short. Not available in production.",
        "operationId": "sandboxPayPaymentRequest",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/sandboxPayRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The customer's payment, as your account sees it (a credit).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/payment"
                }
              }
            }
          },
          "409": {
            "description": "request_not_pending",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "422": {
            "description": "payer_not_demo_customer, and the business rules a payment can break.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Account id. A string: do not do arithmetic on it."
          },
          "accountName": {
            "type": "string",
            "description": "The account's handle, without the leading @. Null if it has none."
          },
          "displayName": {
            "type": "string",
            "description": "Name shown to people paying or being paid by this account."
          },
          "type": {
            "type": "string",
            "description": "personal, business or charity. Other values may be added."
          },
          "tier": {
            "type": "integer",
            "description": "Verification tier, which sets the account's limits.",
            "format": "int32"
          },
          "active": {
            "type": "boolean",
            "description": "False when the account has been deactivated and cannot send or receive."
          },
          "balance": {
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "type": "string",
            "description": "TxGold balance as a decimal string. Null unless the key's role may see it (Admin, Manager, Integration).",
            "format": "decimal",
            "example": "12.50"
          }
        }
      },
      "accountLookup": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "accountName": {
            "type": "string",
            "description": "The account's handle, without the leading @."
          },
          "displayName": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "business or charity."
          }
        }
      },
      "accountTransaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The payment's id; GET /v1/payments/{id}?accountId= returns it in full."
          },
          "direction": {
            "type": "string",
            "description": "debit when the account paid, credit when it was paid."
          },
