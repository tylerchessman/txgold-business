{
  "openapi": "3.0.1",
  "info": {
    "title": "TxGold Business API",
    "description": "Send and request TxGold payments from your own systems. Every request is signed with your integration key (see TXG1 below and https://docs.txgold.money/authentication). Amounts are decimal strings in TxGold units; errors are application/problem+json.",
    "contact": {
      "name": "TxGold",
      "url": "https://docs.txgold.money"
    },
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://func-txgbusiness-dev-ffdea6gbbjhzczex.southcentralus-01.azurewebsites.net",
      "description": "Sandbox"
    }
  ],
  "paths": {
    "/v1/accounts/{accountId}": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get an account",
        "description": "One account the signing key may act for. The balance is filled only for the Admin, Manager and Integration roles.",
        "operationId": "getAccount",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/account"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "404": {
            "description": "The account does not exist, or the key is not attached to it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/accounts/{accountId}/transactions": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "List an account's transactions",
        "description": "Payments in and out of the account, newest first, with each payment's fee, counterparty, USD value and links to its payment request and refund. Balances are filled only for the Admin, Manager and Integration roles.",
        "operationId": "listAccountTransactions",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Earliest time, inclusive: ISO 8601 with Z or an offset (URL-encode a +), or a date (midnight UTC).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Latest time, exclusive. Same format as from.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1-200, default 50.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "nextCursor from the previous page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of transactions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/page_accountTransaction"
                }
              }
            }
          },
          "404": {
            "description": "The account does not exist, or the key is not attached to it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/accounts/lookup": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Find a business or charity by its handle",
        "description": "Resolves a handle such as @PoolMan to an account id before paying it. Exact match only, and only active business and charity accounts: personal accounts cannot be looked up.",
        "operationId": "lookupAccount",
        "parameters": [
          {
            "name": "accountName",
            "in": "query",
            "description": "The handle, with or without the leading @.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/accountLookup"
                }
              }
            }
          },
          "404": {
            "description": "No active business or charity account has that handle.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rates": {
      "get": {
        "tags": [
          "Reference data"
        ],
        "summary": "Get the TxGold rate",
        "description": "What one TxGold is worth in US dollars now, from the gold price TxGold records every half hour.",
        "operationId": "getRates",
        "responses": {
          "200": {
            "description": "The current rate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/rate"
                }
              }
            }
          },
          "503": {
            "description": "rate_unavailable: no gold price has been recorded.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/payment-requests": {
      "post": {
        "tags": [
          "Payment requests"
        ],
        "summary": "Request a payment",
        "description": "Asks a TxGold account to pay one of yours, named by payerAccountId or payerHandle. With neither, makes an open request: nobody is notified, and anyone with its paymentUrl can pay it, once. Resending the identical signed request (same TxG-Timestamp) returns the existing request with 200 instead of creating another.",
        "operationId": "createPaymentRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/paymentRequestCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created; a named payer was notified if their phone is registered. An open request carries its paymentUrl.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentRequest"
                }
              }
            }
          },
          "200": {
            "description": "Already created by an identical earlier request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentRequest"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "422": {
            "description": "same_account, amount_below_minimum or payer_account_invalid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Payment requests"
        ],
        "summary": "List payment requests",
        "description": "An account's requests, newest first.",
        "operationId": "listPaymentRequests",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "pending, paid, dismissed, cancelled or expired.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1-200, default 50.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "nextCursor from the previous page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/page_paymentRequest"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request: a bad accountId, status, limit or cursor.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "404": {
            "description": "The account does not exist, or the key is not attached to it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/payment-requests/{id}": {
      "get": {
        "tags": [
          "Payment requests"
        ],
        "summary": "Get a payment request",
        "operationId": "getPaymentRequest",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentRequest"
                }
              }
            }
          },
          "404": {
            "description": "No such request, or the key is not attached to the account that made it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/payment-requests/{id}/cancel": {
      "post": {
        "tags": [
          "Payment requests"
        ],
        "summary": "Cancel a payment request",
        "description": "Withdraws a pending request: it disappears from the payer's app, and paying it is refused.",
        "operationId": "cancelPaymentRequest",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentRequest"
                }
              }
            }
          },
          "409": {
            "description": "request_not_pending: already paid, dismissed, cancelled or expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/payments": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Send a payment",
        "description": "Sends TxGold from one of your accounts, optionally paying a payment request addressed to it. Resending the identical signed request (same TxG-Timestamp) returns the original payment with 200 instead of paying twice.",
        "operationId": "createPayment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/paymentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Paid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/payment"
                }
              }
            }
          },
          "200": {
            "description": "Already paid by an identical earlier request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/payment"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "403": {
            "description": "The key's role may not send.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "409": {
            "description": "duplicate_request (a different payment used this timestamp) or request_not_pending.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "422": {
            "description": "insufficient_balance, daily_send_limit_exceeded, amount_must_match_request, payment_request_not_payable and the other business rules.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/payments/{id}": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Get a payment",
        "description": "A payment either side of which the signing key may act for.",
        "operationId": "getPayment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountId",
            "in": "query",
            "description": "The side to see it from, for a key attached to both accounts. Default: the paying side if the key is on it.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The payment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/payment"
                }
              }
            }
          },
          "404": {
            "description": "No such payment, or not visible to this key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/payments/{id}/refunds": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Refund a payment",
        "description": "Returns all or part of a payment your account received to the account that sent it. A payment can be refunded once. TxGold's fee on the original payment is not returned.",
        "operationId": "refundPayment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/refundCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The refund, a payment whose refundOf is the original.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/payment"
                }
              }
            }
          },
          "409": {
            "description": "already_refunded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "422": {
            "description": "refund_exceeds_original, insufficient_balance and the other business rules.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          },
          "401": {
            "description": "invalid_signature, timestamp_out_of_range, key_not_found or key_expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/apiProblem"
                }
              }
            }
          }
        }
      }
    },
